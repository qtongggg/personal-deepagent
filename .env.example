# Model Provider (OpenAI, Anthropic, Google, or DeepSeek)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Jev Decision Model (TypeSafe AI) for fast, low-cost RAG Faithfulness evaluation
JEV_API_KEY=your_jev_api_key_here

# Model Selection
DEFAULT_MODEL=gpt-4o

# Mem0 Long-Term Memory
MEM0_API_KEY=your_mem0_api_key_here

# Local Data Paths
CATALOG_CSV_PATH=data/catalog.csv
CHROMA_PERSIST_DIR=.chroma/

# Retrieval & Guardrail Thresholds
SIMILARITY_THRESHOLD=0.4
MAX_REFERENCES=25
